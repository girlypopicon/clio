<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CLIo.ViewModels"
        xmlns:models="using:CLIo.Models"
        xmlns:converters="using:CLIo.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1320" d:DesignHeight="840"
        Width="1320" Height="840"
        MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        x:Class="CLIo.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/clio.ico"
        FontFamily="Cascadia Code,Cascadia Mono,Consolas,DejaVu Sans Mono,Menlo,monospace"
        Background="#1B1D22"
        Title="CLIo"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="48">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#262930"/>
            <Setter Property="BorderBrush" Value="#2A2D33"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style Selector="Border.message">
            <Setter Property="Background" Value="#2E323A"/>
            <Setter Property="BorderBrush" Value="#2A2D33"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="13"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.message:pointerover">
            <Setter Property="BorderBrush" Value="#C9CED6"/>
            <Setter Property="BoxShadow" Value="0 0 4 0 #66C9CED6, 0 0 14 0 #33C9CED6, 0 0 28 0 #15C9CED6"/>
        </Style>
        <Style Selector="Border.rail">
            <Setter Property="Background" Value="#262930"/>
            <Setter Property="BorderBrush" Value="#2A2D33"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style Selector="Border.modal">
            <Setter Property="Background" Value="#1B1D22"/>
            <Setter Property="BorderBrush" Value="#C9CED6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="22"/>
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#D7DAE0"/>
        </Style>
        <Style Selector="TextBlock.eyebrow">
            <Setter Property="Foreground" Value="#C9CED6"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="LetterSpacing" Value="2"/>
        </Style>
        <Style Selector="TextBlock.title">
            <Setter Property="Foreground" Value="#D5D9E0"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="#D5D9E0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#7B818C"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#1B1D22"/>
            <Setter Property="Foreground" Value="#E6E9EE"/>
            <Setter Property="CaretBrush" Value="#E6E9EE"/>
            <Setter Property="SelectionBrush" Value="#2A2D33"/>
            <Setter Property="BorderBrush" Value="#2A2D33"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontFamily" Value="Cascadia Code,Cascadia Mono,Consolas,DejaVu Sans Mono,Menlo,monospace"/>
        </Style>
        <Style Selector="SelectableTextBlock.messageText">
            <Setter Property="Foreground" Value="#D7DAE0"/>
            <Setter Property="FontFamily" Value="Cascadia Code,Cascadia Mono,Consolas,DejaVu Sans Mono,Menlo,monospace"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="Background" Value="#1B1D22"/>
            <Setter Property="Foreground" Value="#E6E9EE"/>
            <Setter Property="BorderBrush" Value="#2A2D33"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontFamily" Value="Cascadia Code,Cascadia Mono,Consolas,DejaVu Sans Mono,Menlo,monospace"/>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2E323A"/>
            <Setter Property="TextBlock.Foreground" Value="#C9CED6"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#C9CED6"/>
            <Setter Property="Foreground" Value="#1B1D22"/>
            <Setter Property="BorderBrush" Value="#C9CED6"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#E6E9EE"/>
            <Setter Property="TextBlock.Foreground" Value="#1B1D22"/>
        </Style>
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="#1B1D22"/>
            <Setter Property="BorderBrush" Value="#2A2D33"/>
        </Style>
        <Style Selector="Button.icon">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinWidth" Value="32"/>
        </Style>
        <Style Selector="Button.listening /template/ ContentPresenter">
            <Setter Property="Background" Value="#5A5F69"/>
        </Style>

        <Style Selector="Button.nav">
            <Setter Property="Padding" Value="20,11"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="Button.nav.primary">
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Button.dots">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#7B818C"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.dots:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2E323A"/>
            <Setter Property="TextBlock.Foreground" Value="#C9CED6"/>
        </Style>
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ListBox.chatList ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>
        <Style Selector="ListBox.chatList ListBoxItem /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#2E323A"/>
        </Style>
        <Style Selector="ListBox.chatList ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#C9CED6"/>
            <Setter Property="BoxShadow" Value="0 0 4 0 #66C9CED6, 0 0 14 0 #33C9CED6, 0 0 28 0 #15C9CED6"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.taskDone TextBlock">
            <Setter Property="Opacity" Value="0.4"/>
            <Setter Property="TextDecorations" Value="Strikethrough"/>
        </Style>

        <!-- Calendar -->
        <Style Selector="Border.calendarCard">
            <Setter Property="Background" Value="#2E323A"/>
            <Setter Property="BorderBrush" Value="#3A3F4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style Selector="Border.calendarCard TextBlock">
            <Setter Property="Foreground" Value="#D7DAE0"/>
        </Style>
        <Style Selector="TextBlock.calendarTitle">
            <Setter Property="Foreground" Value="#F0F2F5"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.calendarSubtitle">
            <Setter Property="Foreground" Value="#8F96A1"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="Button.calendarNav">
            <Setter Property="Background" Value="#2E323A"/>
            <Setter Property="Foreground" Value="#C9CED6"/>
            <Setter Property="BorderBrush" Value="#3A3F4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="Button.calendarNav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3A3F4A"/>
            <Setter Property="TextBlock.Foreground" Value="#F0F2F5"/>
        </Style>
        <Style Selector="Button.calendarToggle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9AA0AA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.calendarToggle:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3A3F4A"/>
        </Style>
        <Style Selector="Button.calendarToggle.active">
            <Setter Property="Background" Value="#C9CED6"/>
            <Setter Property="Foreground" Value="#1B1D22"/>
        </Style>
        <Style Selector="Button.calendarToggle.active:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#E6E9EE"/>
            <Setter Property="TextBlock.Foreground" Value="#1B1D22"/>
        </Style>
        <Style Selector="TextBlock.calendarWeekday">
            <Setter Property="Foreground" Value="#8F96A1"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style Selector="Button.calendarCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.calendarCell:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.calendarCell:pointerover Border.calendarCell">
            <Setter Property="Background" Value="#3A3F4A"/>
        </Style>
        <Style Selector="Border.calendarCell">
            <Setter Property="Background" Value="#2E323A"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>
        <Style Selector="Border.calendarCell.otherMonth">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>
        <Style Selector="Border.calendarCell.today">
            <Setter Property="Background" Value="#363B45"/>
            <Setter Property="BorderBrush" Value="#C9CED6"/>
        </Style>
        <Style Selector="Border.calendarCell.today TextBlock.calendarDayNumber">
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Border.calendarCell.selected">
            <Setter Property="Background" Value="#434956"/>
            <Setter Property="BorderBrush" Value="#8F96A1"/>
        </Style>
        <Style Selector="Border.calendarCell.compact">
            <Setter Property="MinHeight" Value="84"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
        <Style Selector="Border.calendarCell.compact TextBlock.calendarDayNumber">
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="Border.calendarCell.compact Border.calendarEventChip">
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style Selector="Border.calendarCell.compact Border.calendarEventChip TextBlock">
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style Selector="Border.calendarCell.compact TextBlock.calendarOverflow">
            <Setter Property="FontSize" Value="10"/>
        </Style>
        <Style Selector="TextBlock.calendarDayNumber">
            <Setter Property="Foreground" Value="#AEB4BE"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="Border.calendarEventChip">
            <Setter Property="Background" Value="#434956"/>
            <Setter Property="BorderBrush" Value="#C9CED6"/>
            <Setter Property="BorderThickness" Value="2,0,0,0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Border.calendarEventChip TextBlock">
            <Setter Property="Foreground" Value="#E6E9EE"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="TextBlock.calendarOverflow">
            <Setter Property="Foreground" Value="#8F96A1"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="2,3,0,0"/>
        </Style>
        <Style Selector="Border.calendarCard Border.message">
            <Setter Property="Background" Value="#383C46"/>
            <Setter Property="BorderBrush" Value="#434956"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style Selector="Border.calendarCard TextBox">
            <Setter Property="Background" Value="#383C46"/>
            <Setter Property="Foreground" Value="#D7DAE0"/>
            <Setter Property="CaretBrush" Value="#D7DAE0"/>
            <Setter Property="SelectionBrush" Value="#4A505C"/>
            <Setter Property="BorderBrush" Value="#434956"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style Selector="Border.calendarCard DatePicker, Border.calendarCard TimePicker">
            <Setter Property="Background" Value="#383C46"/>
            <Setter Property="Foreground" Value="#D7DAE0"/>
            <Setter Property="BorderBrush" Value="#434956"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Border.calendarCard Button.primary">
            <Setter Property="Background" Value="#C9CED6"/>
            <Setter Property="Foreground" Value="#1B1D22"/>
            <Setter Property="BorderBrush" Value="#C9CED6"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Border.calendarCard Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#E6E9EE"/>
            <Setter Property="TextBlock.Foreground" Value="#1B1D22"/>
        </Style>
    </Window.Styles>

    <Grid Background="#1B1D22">
        <!-- Main layout: Title bar + hairline + content -->
        <Grid RowDefinitions="Auto,Auto,Auto,*">

            <!-- ═══ TITLE BAR (acts as window drag area) ═══ -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" Height="48" Margin="8,0,8,0"
                  IsHitTestVisible="True" Background="Transparent"
                  PointerPressed="TitleBar_OnPointerPressed">
                <!-- LEFT: Hamburger menu -->
                <Button Grid.Column="0" Content="☰" Classes="icon" FontSize="16" Foreground="#C9CED6"
                        VerticalAlignment="Center" Width="28" Height="28" Padding="0"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Chat" Command="{Binding ShowChatCommand}"/>
                            <MenuItem Header="New focused chat" Command="{Binding CreateChatThreadCommand}"/>
                            <MenuItem Header="Memory" Command="{Binding ShowMemoryCommand}"/>
                            <MenuItem Header="Calendar" Command="{Binding ShowCalendarCommand}"/>
                            <MenuItem Header="Tasks" Command="{Binding ShowTasksCommand}"/>
                            <MenuItem Header="{Binding ReviewMenuHeader}" Command="{Binding ShowReviewCommand}"/>
                            <MenuItem Header="-"/>
                            <MenuItem Header="Settings" Command="{Binding OpenSettingsCommand}"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <!-- Sidebar toggle (next to hamburger) -->
                <Button Grid.Column="1" Content="◧" Classes="icon" FontSize="14" Foreground="#7B818C"
                        VerticalAlignment="Center" Width="28" Height="28" Padding="0" Margin="2,0,0,0"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Command="{Binding ToggleThreadsPanelCommand}"
                        ToolTip.Tip="Toggle sidebar"/>

                <!-- CENTER: silver CLIo wordmark -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0">
                    <TextBlock Text="C" Foreground="#E6E9EE" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="L" Foreground="#C9CED6" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="I" Foreground="#AEB4BE" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="o" Foreground="#8F96A1" FontSize="16" FontWeight="Bold"/>
                </StackPanel>

                <!-- RIGHT: Window controls -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Content="—" Classes="icon" FontSize="12" Foreground="#7B818C" Width="28" Height="28" Padding="0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Click="MinimizeButton_OnClick" ToolTip.Tip="Minimize"/>
                    <Button Content="□" Classes="icon" FontSize="13" Foreground="#7B818C" Width="28" Height="28" Padding="0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Click="MaximizeButton_OnClick" ToolTip.Tip="Maximize"/>
                    <Button Content="×" Classes="icon" FontSize="15" Foreground="#7B818C" Width="28" Height="28" Padding="0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Click="CloseButton_OnClick" ToolTip.Tip="Close"/>
                </StackPanel>
            </Grid>

            <!-- ═══ HAIRLINE ═══ -->
            <Border Grid.Row="1" Height="1" Margin="0,4,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                        <GradientStop Color="#00C9CED6" Offset="0"/>
                        <GradientStop Color="#99C9CED6" Offset="0.5"/>
                        <GradientStop Color="#00C9CED6" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- ═══ MAIN CONTENT AREA ═══ -->
            <!-- ═══ UPDATE BANNER (only appears when a newer release exists) ═══ -->
            <Border Grid.Row="2" IsVisible="{Binding IsUpdateBannerVisible}" Margin="16,10,16,0" Padding="14,8"
                    Background="#2E323A" BorderBrush="#434956" BorderThickness="1" CornerRadius="10">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Grid.Column="0" Text="{Binding UpdateBannerText}" VerticalAlignment="Center" Foreground="#E6E9EE"/>
                    <Button Grid.Column="1" Content="VIEW RELEASE" Classes="primary" Command="{Binding OpenUpdatePageCommand}"/>
                    <Button Grid.Column="2" Content="LATER" Classes="ghost" Command="{Binding DismissUpdateCommand}"/>
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="16,12,16,16" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <!-- Content panel (shares the row with the sidebar; sidebar pushes it right) -->
                <Border Grid.Column="1" Classes="panel">
                    <Grid>
                        <!-- ═══ CHAT VIEW ═══ -->
                        <Grid IsVisible="{Binding IsChatView}" RowDefinitions="Auto,*,Auto">
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Classes="eyebrow" Text="// MAIN CHAT"/>
                                    <TextBlock Text="{Binding SelectedChatTitle}" Classes="title"/>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1">
                                <ListBox x:Name="ChatMessagesList" ItemsSource="{Binding ChatMessages}" SelectionMode="Single">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="models:ChatMessage">
                                            <Border Classes="message" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,0,8">
                                                        <TextBlock Grid.Column="0" Text="{Binding DisplayRole}" Foreground="#C9CED6" FontWeight="Bold"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Timestamp, Converter={x:Static converters:HumanizeDateConverter.Instance}}" Classes="muted" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                        <ItemsControl Grid.Column="2"
                                                                      ItemsSource="{Binding ActionBadges}"
                                                                      IsVisible="{Binding HasActionBadges}"
                                                                      HorizontalAlignment="Right"
                                                                      VerticalAlignment="Center"
                                                                      Margin="6,0">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" Spacing="4"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="models:ActionBadge">
                                                                    <Border CornerRadius="8"
                                                                            Padding="7,2"
                                                                            Background="{Binding Bg}"
                                                                            ToolTip.Tip="{Binding Tooltip}">
                                                                        <TextBlock Text="{Binding Symbol}"
                                                                                   Foreground="White"
                                                                                   FontSize="11"
                                                                                   FontWeight="Bold"
                                                                                   VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <Button Grid.Column="3" Content="&#8942;" Classes="dots">
                                                            <Button.Flyout>
                                                                <MenuFlyout>
                                                                    <MenuItem Header="Copy" Tag="{Binding Content}" Click="CopyMessageButton_OnClick"/>
                                                                </MenuFlyout>
                                                            </Button.Flyout>
                                                        </Button>
                                                    </Grid>
                                                    <SelectableTextBlock Classes="messageText"
                                                                         Text="{Binding Content}"
                                                                         TextWrapping="Wrap"/>
                                                    <Border Classes="calendarCard" Margin="0,10,0,0" IsVisible="{Binding HasCalendarWidget}">
                                                        <StackPanel>
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBlock Grid.Column="0" Classes="calendarSubtitle" Text="This week" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="1" Classes="calendarTitle" FontSize="16" Text="{Binding CalendarWidgetLabel}"/>
                                                            </Grid>
                                                            <UniformGrid Columns="7" Rows="1" Margin="0,8,0,4">
                                                                <TextBlock Classes="calendarWeekday" Text="Sun"/>
                                                                <TextBlock Classes="calendarWeekday" Text="Mon"/>
                                                                <TextBlock Classes="calendarWeekday" Text="Tue"/>
                                                                <TextBlock Classes="calendarWeekday" Text="Wed"/>
                                                                <TextBlock Classes="calendarWeekday" Text="Thu"/>
                                                                <TextBlock Classes="calendarWeekday" Text="Fri"/>
                                                                <TextBlock Classes="calendarWeekday" Text="Sat"/>
                                                            </UniformGrid>
                                                            <ItemsControl ItemsSource="{Binding CalendarWidgetDays}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <UniformGrid Columns="7" Rows="{Binding CalendarWidgetRows}"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="models:CalendarDayCell">
                                                                        <Border Classes="calendarCell compact"
                                                                                Classes.otherMonth="{Binding !IsCurrentMonth}"
                                                                                Classes.today="{Binding IsToday}"
                                                                                Classes.selected="{Binding IsSelected}">
                                                                            <StackPanel>
                                                                                <TextBlock Classes="calendarDayNumber" Text="{Binding DayNumber}"/>
                                                                                <ItemsControl ItemsSource="{Binding VisibleEvents}">
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate DataType="models:CalendarEvent">
                                                                                            <Border Classes="calendarEventChip">
                                                                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                                                            </Border>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                                <TextBlock Classes="calendarOverflow" Text="{Binding OverflowLabel}" IsVisible="{Binding HasOverflow}"/>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>

                            <!-- Input area with inline send button -->
                            <Border Grid.Row="2" Classes="message" Margin="0,12,0,0" Padding="10">
                                <Grid>
                                    <TextBox x:Name="ChatInputBox"
                                             Text="{Binding ChatInput}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="86"
                                             Watermark="message clio..."
                                             Padding="12,12,120,12"/>
                                    <Button Content="↵"
                                            Background="Transparent"
                                            Foreground="#C9CED6"
                                            FontSize="20"
                                            FontWeight="Bold"
                                            BorderThickness="0"
                                            CornerRadius="6"
                                            Width="32" Height="28"
                                            Padding="0"
                                            Margin="0,0,6,6"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Command="{Binding SendChatCommand}"
                                            ToolTip.Tip="Send (Enter)"/>
                                    <TextBlock Text="{Binding VoiceStatus}" IsVisible="{Binding VoiceStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                               Classes="muted" FontSize="11" TextWrapping="Wrap" MaxWidth="360"
                                               HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,6"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,40,6" Spacing="2">
                                        <Button Content="■"
                                                IsVisible="{Binding IsSpeaking}"
                                                Background="Transparent"
                                                Foreground="#C9CED6"
                                                FontSize="14"
                                                BorderThickness="0"
                                                CornerRadius="6"
                                                Width="32" Height="28"
                                                Padding="0"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                Command="{Binding StopSpeakingCommand}"
                                                ToolTip.Tip="Stop speaking"/>
                                        <Button Content="{Binding MicGlyph}"
                                                x:Name="MicButton"
                                                Classes.listening="{Binding IsListening}"
                                                Background="Transparent"
                                                Foreground="#C9CED6"
                                                FontSize="16"
                                                BorderThickness="0"
                                                CornerRadius="6"
                                                MinWidth="32" Height="28"
                                                Padding="6,0"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                Command="{Binding ToggleMicCommand}"
                                                ToolTip.Tip="Dictate (click to start/stop)"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ═══ MEMORY VIEW ═══ -->
                        <Grid IsVisible="{Binding IsMemoryView}" RowDefinitions="Auto,Auto,*,Auto">
                            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                                <TextBlock Classes="eyebrow" Text="// MEMORY"/>
                                <TextBlock Text="{Binding SelectedMemorySection}" Classes="title"/>
                                <TextBlock Text="{Binding MemorySectionDescription}" Classes="muted"/>
                            </StackPanel>

                            <Grid Grid.Row="1" RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" Margin="0,0,0,14" IsVisible="{Binding !IsDatesMemorySection}">
                                <TextBox Grid.Row="0" Grid.Column="0" Watermark="key" Text="{Binding MemoryKey}" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Watermark="value" Text="{Binding MemoryValue}" Margin="0,0,0,8"/>
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                                    <Button Content="[ SAVE MEMORY ]" Classes="primary" Command="{Binding SaveMemoryCommand}"/>
                                    <Button Content="[ DELETE SELECTED ]" Classes="ghost" Command="{Binding DeleteSelectedMemoryCommand}"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14" IsVisible="{Binding IsDatesMemorySection}">
                                <Button Content="[ DELETE SELECTED ]" Classes="ghost" Command="{Binding DeleteSelectedCalendarEventCommand}"/>
                            </StackPanel>

                            <Grid Grid.Row="2">
                                <ListBox ItemsSource="{Binding VisibleMemoryItems}" SelectedItem="{Binding SelectedMemoryItem}" IsVisible="{Binding !IsDatesMemorySection}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="models:MemoryItem">
                                            <Border Classes="message" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Key}" Foreground="#C9CED6" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding Value}" Classes="muted" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <ListBox ItemsSource="{Binding UpcomingCalendarEvents}" SelectedItem="{Binding SelectedUpcomingCalendarEvent}" IsVisible="{Binding IsDatesMemorySection}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="models:CalendarEvent">
                                            <Border Classes="message" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" Foreground="#C9CED6" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding DisplayStartsAt}" Classes="muted"/>
                                                    <TextBlock Text="{Binding Details}" Classes="muted" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>

                            <TextBlock Grid.Row="3" Text="{Binding MemoryStatus}" Classes="muted" Margin="0,12,0,0"/>
                        </Grid>

                        <!-- ═══ CALENDAR VIEW ═══ -->
                        <Grid IsVisible="{Binding IsCalendarView}" RowDefinitions="Auto,*">
                            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                                <TextBlock Classes="eyebrow" Text="// CALENDAR"/>
                                <TextBlock Text="Calendar" Classes="title"/>
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <!-- Month / week grid -->
                                <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
                                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding CalendarHeaderLabel}" Classes="calendarTitle" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Week" Classes="calendarToggle" Classes.active="{Binding IsCalendarWeekView}" Command="{Binding SetCalendarViewModeCommand}" CommandParameter="Week"/>
                                            <Button Content="2 Weeks" Classes="calendarToggle" Classes.active="{Binding IsCalendarTwoWeekView}" Command="{Binding SetCalendarViewModeCommand}" CommandParameter="TwoWeek"/>
                                            <Button Content="Month" Classes="calendarToggle" Classes.active="{Binding IsCalendarMonthView}" Command="{Binding SetCalendarViewModeCommand}" CommandParameter="Month" Margin="0,0,14,0"/>
                                            <Button Content="&#8249;" Classes="calendarNav" Command="{Binding PreviousCalendarPeriodCommand}"/>
                                            <Button Content="Today" Classes="calendarNav" Command="{Binding GoToCalendarTodayCommand}"/>
                                            <Button Content="&#8250;" Classes="calendarNav" Command="{Binding NextCalendarPeriodCommand}" Margin="0"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*,*,*">
                                        <TextBlock Grid.Column="0" Text="SUN" Classes="calendarWeekday"/>
                                        <TextBlock Grid.Column="1" Text="MON" Classes="calendarWeekday"/>
                                        <TextBlock Grid.Column="2" Text="TUE" Classes="calendarWeekday"/>
                                        <TextBlock Grid.Column="3" Text="WED" Classes="calendarWeekday"/>
                                        <TextBlock Grid.Column="4" Text="THU" Classes="calendarWeekday"/>
                                        <TextBlock Grid.Column="5" Text="FRI" Classes="calendarWeekday"/>
                                        <TextBlock Grid.Column="6" Text="SAT" Classes="calendarWeekday"/>
                                    </Grid>

                                    <ItemsControl Grid.Row="2" ItemsSource="{Binding CalendarDays}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="7" Rows="6"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="models:CalendarDayCell">
                                                <Button Classes="calendarCell" Tag="{Binding}" Click="CalendarDayButton_OnClick">
                                                    <Border Classes="calendarCell"
                                                            Classes.otherMonth="{Binding !IsCurrentMonth}"
                                                            Classes.today="{Binding IsToday}"
                                                            Classes.selected="{Binding IsSelected}">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Top" Text="{Binding DayNumber}" Classes="calendarDayNumber"/>
                                                            <StackPanel DockPanel.Dock="Top" Margin="0,4,0,0">
                                                                <ItemsControl ItemsSource="{Binding VisibleEvents}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate DataType="models:CalendarEvent">
                                                                            <Border Classes="calendarEventChip">
                                                                                <TextBlock Text="{Binding Title}"/>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <TextBlock Text="{Binding OverflowLabel}" Classes="calendarOverflow" IsVisible="{Binding HasOverflow}"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Expander Grid.Row="3" Header="Scratchpad" Foreground="#AEB4BE">
                                        <TextBox Margin="0,8,0,0" Text="{Binding Scratchpad}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" Watermark="temporary context for clio..."/>
                                    </Expander>
                                </Grid>

                            </Grid>
                        </Grid>

                        <!-- ═══ REVIEW VIEW ═══ -->
                        <Grid IsVisible="{Binding IsReviewView}" RowDefinitions="Auto,*">
                            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                                <TextBlock Classes="eyebrow" Text="// REVIEW"/>
                                <TextBlock Text="Review" Classes="title"/>
                                <TextBlock Text="Things CLIo picked up from chat that disagree with what you set by hand. Your edits stay exactly as they are until you decide."
                                           Classes="muted" TextWrapping="Wrap"/>
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Nothing to review." Classes="muted" IsVisible="{Binding HasNoReviewItems}"/>
                                    <ItemsControl ItemsSource="{Binding ReviewItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="models:ReviewItem">
                                                <Border Classes="calendarCard" Margin="0,0,0,10" Padding="14">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                        <StackPanel Grid.Column="0" Spacing="2">
                                                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding Evidence}" Classes="calendarSubtitle"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <Button Content="KEEP MINE" Classes="ghost"
                                                                    Command="{Binding $parent[Window].DataContext.DismissReviewCommand}"
                                                                    CommandParameter="{Binding}"/>
                                                            <Button Content="USE CHAT'S" Classes="primary"
                                                                    Command="{Binding $parent[Window].DataContext.AcceptReviewCommand}"
                                                                    CommandParameter="{Binding}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- ═══ TASKS VIEW ═══ -->
                        <Grid IsVisible="{Binding IsTasksView}" RowDefinitions="Auto,Auto,*,Auto">
                            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                                <TextBlock Classes="eyebrow" Text="// TASKS"/>
                                <TextBlock Text="Tasks" Classes="title"/>
                                <TextBlock Text="Open loops, to-dos, and things without a date yet." Classes="muted"/>
                            </StackPanel>

                            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                                <TextBox Grid.Column="0" Watermark="new task..." Text="{Binding NewTaskTitle}" Margin="0,0,8,0"/>
                                <Button Grid.Column="1" Content="[ ADD ]" Classes="primary" Command="{Binding AddTaskCommand}"/>
                            </Grid>

                            <ListBox Grid.Row="2" ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="models:JournalTask">
                                        <Border Classes="message" Classes.taskDone="{Binding IsDone}" Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsDone, Mode=TwoWay}" Margin="0,0,12,0" VerticalAlignment="Center"
                                                          Command="{Binding $parent[Window].DataContext.ToggleSelectedTaskCommand}"
                                                          CommandParameter="{Binding}"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                                                    <TextBlock Text="{Binding Id, StringFormat='#{0}'}" Foreground="#7B818C" FontSize="11" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Content="[ &#8594; CAL ]" Classes="ghost" Margin="8,0,0,0"
                                                        Command="{Binding $parent[Window].DataContext.OpenScheduleTaskModalCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Grid.Column="3" Content="[ &#215; ]" Classes="ghost" Margin="4,0,0,0"
                                                        Command="{Binding $parent[Window].DataContext.DeleteSelectedTaskCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Grid.Row="3" Text="{Binding Tasks.Count, StringFormat='{}{0} task(s)'}" Classes="muted" Margin="0,12,0,0"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ═══ LEFT SIDEBAR (docked; pushes the content panel aside) ═══ -->
                <Border Grid.Column="0"
                        Background="#262930"
                        Width="300"
                        VerticalAlignment="Stretch"
                        CornerRadius="16"
                        Padding="16"
                        IsVisible="{Binding IsThreadsPanelOpen}">
                    <Grid RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                            <StackPanel Grid.Column="0">
                                <TextBlock Classes="eyebrow" Text="// CLIO"/>
                                <TextBlock Text="{Binding CurrentView}" Classes="title"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="&#8249;&#8249;" Classes="icon" FontSize="14" FontWeight="Bold"
                                    Command="{Binding ToggleThreadsPanelCommand}" VerticalAlignment="Top"
                                    ToolTip.Tip="Collapse panel"/>
                        </Grid>

                        <Grid Grid.Row="1">
                            <!-- Chat threads list -->
                            <Grid IsVisible="{Binding IsChatView}" RowDefinitions="Auto,*,Auto" RowSpacing="10">
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Chats" Foreground="#C9CED6" FontWeight="Bold"/>
                                        <TextBlock Text="Main and scoped threads" Classes="muted" FontSize="12"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="+" Classes="icon" Command="{Binding CreateChatThreadCommand}" VerticalAlignment="Center" Margin="0" FontSize="18"/>
                                </Grid>

                                <ListBox Grid.Row="1" Classes="chatList" ItemsSource="{Binding ChatThreads}" SelectedItem="{Binding SelectedChatThread}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="models:ChatThread">
                                            <Grid ColumnDefinitions="*,Auto" MinHeight="34" Margin="2,0">
                                                <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="#D7DAE0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="..." Classes="icon" VerticalAlignment="Center">
                                                    <Button.Flyout>
                                                        <MenuFlyout>
                                                            <MenuItem Header="Rename" Tag="{Binding}" Click="RenameChatThreadMenuItem_OnClick"/>
                                                            <MenuItem Header="Summarize" Tag="{Binding}" Click="SummarizeChatThreadMenuItem_OnClick"/>
                                                            <MenuItem Header="Clear messages" Tag="{Binding}" Click="ClearChatThreadMenuItem_OnClick"/>
                                                            <MenuItem Header="Delete" Tag="{Binding}" Click="DeleteChatThreadMenuItem_OnClick"/>
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock Grid.Row="2" Text="{Binding ChatSidebarStatus}" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                            </Grid>

                            <!-- Memory categories -->
                            <StackPanel IsVisible="{Binding IsMemoryView}" Spacing="6">
                                <Button Content="[ USER ]" Classes="ghost" Command="{Binding ShowMemoryCategoryCommand}" CommandParameter="user" HorizontalAlignment="Stretch"/>
                                <Button Content="[ PEOPLE ]" Classes="ghost" Command="{Binding ShowMemoryCategoryCommand}" CommandParameter="people" HorizontalAlignment="Stretch"/>
                                <Button Content="[ PROJECTS ]" Classes="ghost" Command="{Binding ShowMemoryCategoryCommand}" CommandParameter="projects" HorizontalAlignment="Stretch"/>
                                <Button Content="[ GOALS ]" Classes="ghost" Command="{Binding ShowMemoryCategoryCommand}" CommandParameter="goals" HorizontalAlignment="Stretch"/>
                                <Button Content="[ CONTEXT ]" Classes="ghost" Command="{Binding ShowMemoryCategoryCommand}" CommandParameter="context" HorizontalAlignment="Stretch"/>
                                <Button Content="[ KNOWLEDGE ]" Classes="ghost" Command="{Binding ShowMemoryCategoryCommand}" CommandParameter="knowledge" HorizontalAlignment="Stretch"/>
                                <Button Content="[ SYSTEMS ]" Classes="ghost" Command="{Binding ShowMemoryCategoryCommand}" CommandParameter="systems" HorizontalAlignment="Stretch"/>
                                <Button Content="[ TOOLS ]" Classes="ghost" Command="{Binding ShowMemoryCategoryCommand}" CommandParameter="tools" HorizontalAlignment="Stretch"/>
                                <Button Content="[ META ]" Classes="ghost" Command="{Binding ShowMemoryCategoryCommand}" CommandParameter="meta" HorizontalAlignment="Stretch"/>
                                <Button Content="[ FLEX ]" Classes="ghost" Command="{Binding ShowMemoryCategoryCommand}" CommandParameter="flex" HorizontalAlignment="Stretch"/>
                                <Button Content="[ DATES ]" Classes="ghost" Command="{Binding ShowMemoryCategoryCommand}" CommandParameter="dates" HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <!-- Calendar navigation -->
                            <StackPanel IsVisible="{Binding IsCalendarView}" Spacing="10">
                                <TextBlock Text="Period" Classes="label"/>
                                <TextBlock Text="{Binding CalendarHeaderLabel}" Foreground="#C9CED6" FontWeight="Bold" Margin="0,0,0,8"/>
                                <Button Content="[ PREVIOUS ]" Classes="ghost" Command="{Binding PreviousCalendarPeriodCommand}" HorizontalAlignment="Stretch"/>
                                <Button Content="[ TODAY ]" Classes="primary" Command="{Binding GoToCalendarTodayCommand}" HorizontalAlignment="Stretch"/>
                                <Button Content="[ NEXT ]" Classes="ghost" Command="{Binding NextCalendarPeriodCommand}" HorizontalAlignment="Stretch"/>
                                <TextBlock Text="Selected day" Classes="label" Margin="0,18,0,0"/>
                                <TextBlock Text="{Binding SelectedCalendarDateLabel}" Classes="muted" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ═══ DAY MODAL ═══ -->
        <Border IsVisible="{Binding IsDayModalOpen}" Background="#CC1B1D22">
            <Border Classes="modal" Width="560" MaxHeight="680" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Classes="eyebrow" Text="// DAY"/>
                            <TextBlock Text="{Binding SelectedCalendarDateLabel}" Classes="title"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="&#215;" Classes="icon" FontSize="18" VerticalAlignment="Top"
                                Command="{Binding CloseDayModalCommand}" ToolTip.Tip="Close"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Nothing scheduled for this day." Classes="muted" IsVisible="{Binding HasNoDayEvents}"/>
                            <ItemsControl ItemsSource="{Binding DayEditors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:CalendarEventEditor">
                                        <Border Classes="calendarCard" Margin="0,0,0,10" Padding="12">
                                            <StackPanel Spacing="8">
                                                <TextBox Text="{Binding Title}" Watermark="Title"/>
                                                <TimePicker SelectedTime="{Binding Time}"/>
                                                <TextBox Text="{Binding Details}" Watermark="Details" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"/>
                                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                                    <Button Content="DELETE" Classes="ghost"
                                                            Command="{Binding $parent[Window].DataContext.DeleteEventEditorCommand}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="SAVE" Classes="primary"
                                                            Command="{Binding $parent[Window].DataContext.SaveEventEditorCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Classes="calendarCard" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Add to this day" Classes="calendarSubtitle"/>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0" Watermark="Event title" Text="{Binding EventTitle}"/>
                                <TimePicker Grid.Column="1" SelectedTime="{Binding EventTime}"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0" Watermark="Details (optional)" Text="{Binding EventDetails}"/>
                                <Button Grid.Column="1" Content="ADD" Classes="primary" Command="{Binding AddEventCommand}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Border>

        <!-- ═══ SCHEDULE TASK MODAL ═══ -->
        <Border IsVisible="{Binding IsScheduleTaskModalOpen}" Background="#CC1B1D22">
            <Border Classes="modal" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="18">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Classes="eyebrow" Text="// TASKS"/>
                            <TextBlock Text="Move to calendar" Classes="title"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="[ CLOSE ]" Classes="ghost" Command="{Binding CloseScheduleTaskModalCommand}" VerticalAlignment="Top"/>
                    </Grid>

                    <StackPanel Grid.Row="1">
                        <TextBlock Classes="label" Text="Task"/>
                        <TextBlock Text="{Binding TaskBeingScheduled.Title}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8">
                        <DatePicker Grid.Column="0" SelectedDate="{Binding ScheduleTaskDate}"/>
                        <TimePicker Grid.Column="1" SelectedTime="{Binding ScheduleTaskTime}"/>
                    </Grid>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="[ CANCEL ]" Classes="ghost" Command="{Binding CloseScheduleTaskModalCommand}"/>
                        <Button Content="[ ADD TO CALENDAR ]" Classes="primary" Command="{Binding ConfirmScheduleTaskCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- ═══ CHAT RENAME MODAL ═══ -->
        <Border IsVisible="{Binding IsChatRenameOpen}" Background="#CC1B1D22">
            <Border Classes="modal" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="18">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Classes="eyebrow" Text="// CHAT"/>
                            <TextBlock Text="Rename chat" Classes="title"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="[ CLOSE ]" Classes="ghost" Command="{Binding CloseChatRenameFromDialogCommand}" VerticalAlignment="Top"/>
                    </Grid>

                    <TextBox x:Name="RenameChatTitleBox" Grid.Row="1" Text="{Binding RenameChatTitle}" Watermark="chat title"/>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="[ CANCEL ]" Classes="ghost" Command="{Binding CloseChatRenameFromDialogCommand}"/>
                        <Button Content="[ SAVE ]" Classes="primary" Command="{Binding SaveChatRenameFromDialogCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- ═══ SETTINGS MODAL ═══ -->
        <Border IsVisible="{Binding IsSettingsOpen}" Background="#CC1B1D22">
            <Border Classes="modal" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="18">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Classes="eyebrow" Text="// SETTINGS"/>
                            <TextBlock Text="DeepSeek" Classes="title"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="[ CLOSE ]" Classes="ghost" Command="{Binding CloseSettingsCommand}" VerticalAlignment="Top"/>
                    </Grid>

                    <StackPanel Grid.Row="1">
                        <TextBlock Classes="label" Text="DeepSeek API key"/>
                        <TextBox Classes="revealPasswordButton" Text="{Binding DeepSeekApiKey}" PasswordChar="*" Watermark="sk-..."/>
                        <TextBlock Text="Stored locally in CLIo settings and loaded when the app starts." Classes="muted" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Spacing="8">
                        <TextBlock Classes="label" Text="Voice"/>
                        <CheckBox Content="Speak CLIo's replies aloud" IsChecked="{Binding SpeakReplies}"/>
                        <CheckBox Content="Send dictation automatically when I stop the mic" IsChecked="{Binding AutoSendVoice}"/>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <TextBlock Grid.Column="0" Text="Voice speed" Classes="muted" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Minimum="0.6" Maximum="1.6" Value="{Binding VoiceSpeed}"/>
                            <TextBlock Grid.Column="2" Text="{Binding VoiceSpeed, StringFormat='{}{0:0.00}x'}" Classes="muted" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <TextBlock Grid.Column="0" Text="Expressiveness" Classes="muted" VerticalAlignment="Center" Width="100"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="1.2" Value="{Binding VoiceExpressiveness}"/>
                            <TextBlock Grid.Column="2" Text="{Binding VoiceExpressiveness, StringFormat='{}{0:0.00}'}" Classes="muted" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <TextBlock Grid.Column="0" Text="Cadence" Classes="muted" VerticalAlignment="Center" Width="100"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="1.2" Value="{Binding VoiceCadence}"/>
                            <TextBlock Grid.Column="2" Text="{Binding VoiceCadence, StringFormat='{}{0:0.00}'}" Classes="muted" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <TextBlock Grid.Column="0" Text="Sentence pause" Classes="muted" VerticalAlignment="Center" Width="100"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding VoicePause}"/>
                            <TextBlock Grid.Column="2" Text="{Binding VoicePause, StringFormat='{}{0:0.00}s'}" Classes="muted" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="[ PREVIEW ]" Classes="ghost" Command="{Binding PreviewVoiceCommand}"/>
                            <Button Content="[ RESET ]" Classes="ghost" Command="{Binding ResetVoiceTuningCommand}"/>
                        </StackPanel>
                        <TextBlock Classes="label" Text="Voice models" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding VoiceModelsStatus}" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock Text="Better dictation and a natural voice run fully on this PC. One-time download, about 285 MB, from Hugging Face and GitHub." Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding CanDownloadVoiceModels}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="[ DOWNLOAD VOICE MODELS ]" Classes="primary" Command="{Binding DownloadVoiceModelsCommand}" IsVisible="{Binding CanDownloadVoiceModels}"/>
                            <Button Content="[ CANCEL DOWNLOAD ]" Classes="ghost" Command="{Binding CancelVoiceDownloadCommand}" IsVisible="{Binding IsDownloadingVoice}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding VoiceDownloadProgress}" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                        <CheckBox Content="Polish dictation with DeepSeek (fixes names and punctuation)" IsChecked="{Binding PolishDictation}"/>
                        <CheckBox Content="Local only: never send my voice to a server" IsChecked="{Binding LocalSpeechOnly}"/>
                        <TextBlock Classes="label" Text="Whisper server (optional)" Margin="0,8,0,0"/>
                        <TextBox Text="{Binding SttServerUrl}" Watermark="https://clio-stt.your-name.workers.dev  (blank = local only)"/>
                        <TextBox Text="{Binding SttServerModel}" Watermark="model name (only for your own Whisper server)"/>
                        <TextBox Classes="revealPasswordButton" Text="{Binding SttServerKey}" PasswordChar="*" Watermark="API key (only for your own Whisper server)"/>
                        <TextBlock Text="Paste the URL of your CLIo speech Worker (see worker/README.md). Self-hosted OpenAI-compatible servers work too. Falls back to local Whisper if unreachable." Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock Classes="label" Text="Voice corrections" Margin="0,8,0,0"/>
                        <TextBox Text="{Binding VoiceCorrectionsText}" AcceptsReturn="True" TextWrapping="NoWrap" Height="84"
                                 Watermark="heard => correct, one per line&#10;dock lite => Docklite"/>
                        <TextBlock Text="Words speech recognition keeps getting wrong. CLIo also auto-fixes near-misses of names it knows (people, projects, tools) and logs each fix in __dev." Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock Text="Uses the local Windows speech engines. Nothing leaves your machine." Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding VoiceStatus}" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBlock Grid.Row="3" Text="{Binding SettingsStatus}" Foreground="#C9CED6" TextWrapping="Wrap"/>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="[ CANCEL ]" Classes="ghost" Command="{Binding CloseSettingsCommand}"/>
                        <Button Content="[ SAVE SETTINGS ]" Classes="primary" Command="{Binding SaveSettingsCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- ═══ MEMORY TOAST ═══ -->
        <Border Classes="modal" IsVisible="{Binding MemoryToastVisible}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,24,24" MaxWidth="380" CornerRadius="12">
            <StackPanel Spacing="12">
                <TextBlock Text="{Binding MemoryToastMessage}" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="[ SKIP ]" Classes="ghost" Command="{Binding DismissMemoryToastCommand}"/>
                    <Button Content="[ STORE ]" Classes="primary" Command="{Binding AcceptMemoryToastCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

    </Grid>
</Window>
