<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="260"
        x:Class="CLIo.Views.SplashWindow"
        Width="420" Height="260"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Icon="/Assets/clio.ico"
        FontFamily="Cascadia Code,Cascadia Mono,Consolas,DejaVu Sans Mono,Menlo,monospace"
        Title="CLIo">

    <Border Background="#1B1D22" BorderBrush="#C9CED6" BorderThickness="1" CornerRadius="6">
        <Grid RowDefinitions="*,1">
            <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="C" FontSize="42" FontWeight="Bold" Foreground="#E6E9EE"/>
                    <TextBlock Text="L" FontSize="42" FontWeight="Bold" Foreground="#C9CED6"/>
                    <TextBlock Text="I" FontSize="42" FontWeight="Bold" Foreground="#AEB4BE"/>
                    <TextBlock Text="o" FontSize="42" FontWeight="Bold" Foreground="#8F96A1"/>
                    <TextBlock Text="_" FontSize="42" FontWeight="Bold" Foreground="#737A85"/>
                </StackPanel>
                <TextBlock Text="warming up..." FontSize="13" Foreground="#7B818C"
                           LetterSpacing="2" HorizontalAlignment="Center"/>
            </StackPanel>
            <Border Grid.Row="1" CornerRadius="0,0,6,6">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                        <GradientStop Color="#E6E9EE" Offset="0"/>
                        <GradientStop Color="#C9CED6" Offset="0.2"/>
                        <GradientStop Color="#AEB4BE" Offset="0.4"/>
                        <GradientStop Color="#8F96A1" Offset="0.6"/>
                        <GradientStop Color="#737A85" Offset="0.8"/>
                        <GradientStop Color="#5A606A" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Grid>
    </Border>

</Window>
