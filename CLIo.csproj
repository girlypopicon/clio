<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\clio.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <Version>0.5.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.7" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.3.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.7" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.7" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.7" />
    <PackageReference Include="BotSharp.Core" Version="5.2.0" />
    <PackageReference Include="Catalyst" Version="26.6.2084" />
    <PackageReference Include="Catalyst.Models.English" Version="1.0.30952" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
    <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
    <PackageReference Include="Humanizer" Version="3.0.10" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="9.0.5" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageReference Include="Microsoft.Recognizers.Text.DateTime" Version="1.8.13" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.10" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Whisper.net" Version="1.8.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.8.1" />
    <PackageReference Include="System.Speech" Version="9.0.5" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.9" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="agents\**\*.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The architecture reference (SelfDocs/architecture.md) is encrypted at build time and embedded as
    CLIo.SelfDocs.architecture.bin; the readable file is never shipped. The key phrase comes from the
    CLIO_SELFDOCS_KEY environment variable when set (use that for release builds, so the phrase is not
    in source control); otherwise the development phrase below is used. A generated source file hands the
    phrase to the program in obfuscated form. See SelfDocsCrypto.cs for what this does and does not protect.
  -->
  <PropertyGroup>
    <SelfDocsPhrase>$(CLIO_SELFDOCS_KEY)</SelfDocsPhrase>
    <SelfDocsPhrase Condition="'$(SelfDocsPhrase)' == ''">clio-development-phrase-set-CLIO_SELFDOCS_KEY-for-release-builds</SelfDocsPhrase>
  </PropertyGroup>

  <UsingTask TaskName="EncryptSelfDocs" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <Phrase ParameterType="System.String" Required="true" />
      <EncryptedOutput ParameterType="System.String" Required="true" />
      <KeySourceOutput ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Security.Cryptography" />
      <Code Type="Fragment" Language="cs"><![CDATA[
var plain = File.ReadAllBytes(Source);
var encKey = SHA256.Create().ComputeHash(Encoding.UTF8.GetBytes(Phrase + "|enc"));
var macKey = SHA256.Create().ComputeHash(Encoding.UTF8.GetBytes(Phrase + "|mac"));
var iv = new byte[16];
RandomNumberGenerator.Create().GetBytes(iv);

byte[] cipher;
using (var aes = Aes.Create())
{
    aes.Key = encKey;
    aes.IV = iv;
    aes.Mode = CipherMode.CBC;
    aes.Padding = PaddingMode.PKCS7;
    using (var encryptor = aes.CreateEncryptor())
    {
        cipher = encryptor.TransformFinalBlock(plain, 0, plain.Length);
    }
}

var body = Encoding.ASCII.GetBytes("CSD1").Concat(iv).Concat(cipher).ToArray();
byte[] mac;
using (var hmac = new HMACSHA256(macKey))
{
    mac = hmac.ComputeHash(body);
}

Directory.CreateDirectory(Path.GetDirectoryName(EncryptedOutput));
File.WriteAllBytes(EncryptedOutput, body.Concat(mac).ToArray());

// The phrase reaches the program as masked bytes, not a readable string literal.
var phraseBytes = Encoding.UTF8.GetBytes(Phrase);
var masked = phraseBytes.Select((b, i) => (byte)(b ^ (byte)(0x5A + (i * 7) % 61))).ToArray();
var sb = new StringBuilder();
sb.AppendLine("// <auto-generated> by the EncryptSelfDocs build target. Do not edit.");
sb.AppendLine("namespace CLIo.Services.Skills;");
sb.AppendLine("internal static class SelfDocsKey");
sb.AppendLine("{");
sb.AppendLine("    private static readonly byte[] Masked = new byte[] { " + string.Join(", ", masked.Select(b => b.ToString())) + " };");
sb.AppendLine("    internal static string Phrase()");
sb.AppendLine("    {");
sb.AppendLine("        var bytes = new byte[Masked.Length];");
sb.AppendLine("        for (var i = 0; i < bytes.Length; i++) bytes[i] = (byte)(Masked[i] ^ (byte)(0x5A + (i * 7) % 61));");
sb.AppendLine("        return System.Text.Encoding.UTF8.GetString(bytes);");
sb.AppendLine("    }");
sb.AppendLine("}");
File.WriteAllText(KeySourceOutput, sb.ToString());
]]></Code>
    </Task>
  </UsingTask>

  <Target Name="EncryptSelfDocs" BeforeTargets="AssignTargetPaths;CoreCompile"
          Inputs="SelfDocs\architecture.md;$(MSBuildProjectFullPath)"
          Outputs="$(IntermediateOutputPath)selfdocs.bin;$(IntermediateOutputPath)SelfDocsKey.g.cs">
    <EncryptSelfDocs Source="SelfDocs\architecture.md"
                     Phrase="$(SelfDocsPhrase)"
                     EncryptedOutput="$(IntermediateOutputPath)selfdocs.bin"
                     KeySourceOutput="$(IntermediateOutputPath)SelfDocsKey.g.cs" />
  </Target>

  <Target Name="IncludeSelfDocs" BeforeTargets="AssignTargetPaths;CoreCompile" DependsOnTargets="EncryptSelfDocs">
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)selfdocs.bin" LogicalName="CLIo.SelfDocs.architecture.bin" />
      <Compile Include="$(IntermediateOutputPath)SelfDocsKey.g.cs" />
    </ItemGroup>
  </Target>

  <!-- Strict versioning: the build fails unless the newest patch-notes entry is exactly <Version>.
       Bump <Version> and add the entry together (see docs/VERSIONING.md). -->
  <Target Name="CheckVersionHasPatchNotes" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <PatchNotesSource>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/Services/SystemPromptBuilder.cs'))</PatchNotesSource>
      <NewestPatchNotesVersion>$([System.Text.RegularExpressions.Regex]::Match('$(PatchNotesSource)', 'new\("v([0-9]+[.][0-9]+[.][0-9]+)"').Groups[1].Value)</NewestPatchNotesVersion>
    </PropertyGroup>
    <Error Condition="'$(NewestPatchNotesVersion)' != '$(Version)'"
           Text="Version mismatch: CLIo.csproj says $(Version) but the newest patch-notes entry in Services/SystemPromptBuilder.cs is '$(NewestPatchNotesVersion)'. Bump both together (docs/VERSIONING.md)." />
  </Target>
</Project>
